pipeline {
    agent any

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Docker image tag from CI pipeline'
        )
    }

    environment {
        DOCKER_IMAGE = "amarskarande/travel-buddy"
        APP_URL = "http://travelbuddy-alb-1362944142.us-east-1.elb.amazonaws.com/"
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        stage('Checkout GitOps Repository') {
            steps {
                checkout scm
            }
        }

        stage('Validate IMAGE_TAG') {
            steps {
                script {
                    if (!params.IMAGE_TAG?.trim()) {
                        error("IMAGE_TAG is empty.")
                    }
                }
            }
        }

        stage('Ensure Required Tools') {
            steps {
                sh '''
                set -e
                command -v yq     >/dev/null 2>&1 && echo "yq OK: $(yq --version)"
                command -v git    >/dev/null 2>&1 && echo "git OK: $(git --version)"
                command -v docker >/dev/null 2>&1 && echo "docker OK: $(docker --version)"

                if command -v curl >/dev/null 2>&1; then
                    echo "curl OK (host): $(curl --version | head -1)"
                else
                    echo "curl not found on host - will use dockerized curl (curlimages/curl) instead."
                fi
                '''
            }
        }

        stage('Update deployment.yaml') {
            steps {
                sh """
                yq e -i '.spec.template.spec.containers[0].image = "${DOCKER_IMAGE}:${params.IMAGE_TAG}"' deployment.yaml
                """
            }
        }

        stage('Commit Changes') {
            steps {
                sh """
                git config user.email "jenkins@travelbuddy.com"
                git config user.name "Jenkins CD"

                git add deployment.yaml

                if git diff --cached --quiet; then
                    echo "No changes to commit."
                else
                    git commit -m "Deploy image ${DOCKER_IMAGE}:${params.IMAGE_TAG}"
                fi
                """
            }
        }

        stage('Push GitOps Repository') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-creds',
                        usernameVariable: 'GIT_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                    git push https://$GIT_USER:$GITHUB_TOKEN@github.com/AmarKarande/travel-buddy-gitops.git HEAD:main
                    '''
                }
            }
        }

        stage('Wait for Application') {
            steps {
                sh '''
                set +e
                echo "Waiting for application..."

                for i in $(seq 1 60)
                do
                    STATUS=$(docker run --rm curlimages/curl -s -o /dev/null -w "%{http_code}" --max-time 5 "$APP_URL")

                    if [ "$STATUS" = "200" ]; then
                        echo "Application is available (HTTP $STATUS)."
                        exit 0
                    fi

                    echo "Attempt $i/60 - got HTTP '$STATUS' - waiting 10 seconds..."
                    sleep 10
                done

                echo "Application failed to become available after 60 attempts."
                exit 1
                '''
            }
        }

        stage('OWASP ZAP DAST Scan') {
            steps {
                sh '''
                set -e

                docker image inspect ghcr.io/zaproxy/zaproxy:stable >/dev/null 2>&1 || \
                docker pull ghcr.io/zaproxy/zaproxy:stable

                chmod 777 "$WORKSPACE"

                docker run --rm \
                  -v "$WORKSPACE:/zap/wrk:rw" \
                  ghcr.io/zaproxy/zaproxy:stable \
                  zap-baseline.py \
                  -t "$APP_URL" \
                  -r zap-report.html \
                  -J zap-report.json \
                  -x zap-report.xml \
                  -m 15 \
                  -T 20 \
                  -I
                '''
            }
        }

        stage('Deployment Completed') {
            steps {
                echo "Deployment completed successfully."
            }
        }
    }

    post {

        success {
            echo "CD Pipeline Completed Successfully"
        }

        failure {
            echo "CD Pipeline Failed"
        }

        always {

            archiveArtifacts artifacts: '''
deployment.yaml,
zap-report.html,
zap-report.json,
zap-report.xml
''', allowEmptyArchive: true

            publishHTML(target: [
                allowMissing: true,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: '.',
                reportFiles: 'zap-report.html',
                reportName: 'OWASP ZAP Report'
            ])

            cleanWs()
        }
    }
}
