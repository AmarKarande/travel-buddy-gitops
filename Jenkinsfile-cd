pipeline {
    agent any

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Docker image tag from CI pipeline'
        )
    }

    environment {
        DOCKER_IMAGE = "amarskarande/travel-buddy"
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        stage('Checkout GitOps Repository') {
            steps {
                checkout scm
            }
        }

        stage('Verify Current Deployment') {
            steps {
                sh '''
                    echo "Current deployment.yaml"
                    cat deployment.yaml
                '''
            }
        }

        stage('Validate Image Tag') {
            steps {
                script {
                    if (!params.IMAGE_TAG?.trim()) {
                        error """
IMAGE_TAG parameter is empty.

This job should be triggered automatically by the CI pipeline.
If you are running this job manually, provide a valid Docker image tag.
"""
                    }
                }
            }
        }

        stage('Update Image Tag') {
            steps {
                sh """
                    yq e -i \
                    '.spec.template.spec.containers[0].image = "${DOCKER_IMAGE}:${params.IMAGE_TAG}"' \
                    deployment.yaml
                """
            }
        }

        stage('Verify Updated Deployment') {
            steps {
                sh '''
                    echo "Updated deployment.yaml"
                    cat deployment.yaml
                '''
            }
        }

        stage('Commit Changes') {
            steps {
                sh """
                    git config user.email "jenkins@travelbuddy.com"
                    git config user.name "Jenkins CD"

                    git add deployment.yaml

                    if git diff --cached --quiet; then
                        echo "No changes detected."
                    else
                        git commit -m "Deploy image ${DOCKER_IMAGE}:${params.IMAGE_TAG}"
                    fi
                """
            }
        }

        stage('Push Changes') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-creds',
                        usernameVariable: 'GIT_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        git push \
                        https://$GIT_USER:$GITHUB_TOKEN@github.com/AmarKarande/travel-buddy-gitops.git \
                        HEAD:main
                    '''
                }
            }
        }

        stage('Deployment Completed') {
            steps {
                echo "========================================="
                echo "GitOps repository updated successfully."
                echo "Argo CD will automatically sync."
                echo "Kubernetes RollingUpdate started."
                echo "Image: ${DOCKER_IMAGE}:${params.IMAGE_TAG}"
                echo "========================================="
            }
        }
    }

    post {

        success {
            echo "========================================="
            echo "CD Pipeline Completed Successfully"
            echo "Image: ${DOCKER_IMAGE}:${params.IMAGE_TAG}"
            echo "========================================="
        }

        failure {
            echo "========================================="
            echo "CD Pipeline Failed"
            echo "========================================="
        }

        always {
            cleanWs()
        }
    }
}